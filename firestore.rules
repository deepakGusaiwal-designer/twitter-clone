rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Posts collection rules
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
      }
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Messages collection rules
    match /messages/{chatId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      match /chat/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/messages/$(chatId)).data.participants
        );
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      }
    }

    // Hashtags collection rules
    match /hashtags/{hashtagId} {
      allow read: if true; // Public read access for trending hashtags
      allow write: if request.auth != null; // Only authenticated users can update
    }
  }
}